# ---------------------------------------------------------------------------
# Пример файла окружения для PlanMeet.
# Скопируйте этот файл в .env и подставьте реальные значения.
# Файл .env НЕ добавляется в git (см. .gitignore) — в нём хранятся секреты.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SITE_URL=http://127.0.0.1:8000

# База данных
# По умолчанию используется SQLite и переменные ниже не нужны.
# Для MySQL раскомментируйте и заполните:
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_NAME=your_db_name
# DJANGO_DB_USER=your_db_user
# DJANGO_DB_PASSWORD=your_db_password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306

# Почта (SMTP)
# По умолчанию письма выводятся в консоль. Для реальной отправки заполните:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_USE_SSL=True
# DJANGO_EMAIL_HOST_USER=your@email.com
# DJANGO_EMAIL_HOST_PASSWORD=your_email_password
# DJANGO_DEFAULT_FROM_EMAIL=PlanMeet <noreply@example.com>
